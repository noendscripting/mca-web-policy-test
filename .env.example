PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret

# oidc or saml
AUTH_PROVIDER=oidc

# --- OIDC (Microsoft Entra app registration) ---
AAD_TENANT_ID=
AAD_CLIENT_ID=
AAD_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
# Optional overrides. Defaults are derived from the tenant and client IDs.
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_SCOPES=openid profile email api://<client-id>/access_as_user

# --- SAML (Microsoft Entra enterprise application) ---
SAML_ENTRY_POINT=
SAML_ISSUER=http://localhost:3000/saml/metadata
SAML_CALLBACK_URL=http://localhost:3000/auth/callback
# Entra "Certificate (Base64)" contents on one line, without the BEGIN/END lines.
SAML_IDP_CERT=

# --- Azure Storage (leave blank to use the local uploads folder) ---
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=mdca-files
